# Example environment variables for CreatorFuel AI
# Copy to .env and fill with real secrets

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/creatorfuel

# JWT secret used to sign session tokens
JWT_SECRET=replace_with_a_strong_random_value

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Next.js
NEXTAUTH_URL=http://localhost:3000

# Node env
NODE_ENV=development
